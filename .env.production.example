# Production environment configuration
# This file shows the structure needed for remote deployment
# Actual values must be provided via environment variables in CCR

# NewsAPI Configuration
NEWSAPI_KEY=${NEWSAPI_KEY}

# Google Drive Configuration
GOOGLE_APPLICATION_CREDENTIALS=${GOOGLE_APPLICATION_CREDENTIALS}
GOOGLE_DRIVE_FOLDER_ID=${GOOGLE_DRIVE_FOLDER_ID}

# LINE Bot Configuration
LINE_CHANNEL_ACCESS_TOKEN=${LINE_CHANNEL_ACCESS_TOKEN}
LINE_CHANNEL_SECRET=${LINE_CHANNEL_SECRET}
LINE_GROUP_ID=${LINE_GROUP_ID}

# Email Configuration (for fallback alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}
FALLBACK_RECIPIENT_EMAIL=${FALLBACK_RECIPIENT_EMAIL}

# Application Configuration
KEYWORD_LIST=silicon photonics,quantum computing,advanced packaging,chiplet,GPU,interconnection,digital twin,omniverse,generative AI,hybrid bonding,computing in memory,FOPLP,solid state transformer,SiC,GaN,FPGA,micro LED,HBM,TGV,glass substrate
NEWS_SOURCES=https://www.semiconductorpackagingnews.com/,https://www.hpcwire.com/,https://www.digitimes.com.tw/tech/

# Timing Configuration (all times in Taipei timezone UTC+8)
# Daily fetch at 6am, delivery at 7:45am
FETCH_HOUR=6
FETCH_MINUTE=0
DELIVERY_HOUR=7
DELIVERY_MINUTE=45
CURATION_DEADLINE_HOUR=22
CURATION_DEADLINE_MINUTE=0

# System Configuration
LOG_LEVEL=INFO
MAX_ARTICLES_PER_FETCH=20
URL_TIMEOUT_SECONDS=5
MAX_ARTICLE_AGE_HOURS=48
