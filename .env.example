# NewsAPI Configuration
NEWSAPI_KEY=your_newsapi_key_here

# Google Drive Configuration
GOOGLE_APPLICATION_CREDENTIALS=path/to/google_credentials.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# LINE Bot Configuration
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_GROUP_ID=your_line_group_id

# Email Configuration (for fallback alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FALLBACK_RECIPIENT_EMAIL=your_email@example.com

# Application Configuration
KEYWORD_LIST=silicon photonics,quantum computing,advanced packaging,chiplet,GPU,interconnection,digital twin,omniverse,generative AI,hybrid bonding,computing in memory,FOPLP,solid state transformer,SiC,GaN,FPGA,micro LED,HBM,TGV,glass substrate
NEWS_SOURCES=https://www.semiconductorpackagingnews.com/,https://www.hpcwire.com/,https://www.digitimes.com.tw/tech/

# Timing Configuration
FETCH_HOUR=6
FETCH_MINUTE=0
DELIVERY_HOUR=8
DELIVERY_MINUTE=0
CURATION_DEADLINE_HOUR=22
CURATION_DEADLINE_MINUTE=0

# System Configuration
LOG_LEVEL=INFO
MAX_ARTICLES_PER_FETCH=20
URL_TIMEOUT_SECONDS=5
MAX_ARTICLE_AGE_HOURS=48
